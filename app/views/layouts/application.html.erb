<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "BillsAgent" %></title>
    <%= yield :head %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      (function () {
        try {
          var theme = localStorage.getItem("billsAgent.theme") || "terminal";
          if (theme === "default") theme = "dark";
          var alpha = localStorage.getItem("billsAgent.panelAlpha") || "0.66";
          var blur = localStorage.getItem("billsAgent.blur") || "18";
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.setProperty("--theme-panel-alpha", alpha);
          document.documentElement.style.setProperty("--theme-blur", blur + "px");
        } catch (_) {}
      })();
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= controller_name == "pages" && action_name == "home" ? "intro-layout" : "" %>">
    <nav class="navbar">
      <div class="navbar-inner">
        <%= link_to root_path, class: "navbar-brand" do %>
          <span class="bill-brand-mark" aria-hidden="true">↗</span> BillsAgent
        <% end %>

        <div class="navbar-links">
          <%= link_to "Discover", intro_path, class: "navbar-link" %>
          <% if user_signed_in? %>
            <%= link_to "Dashboard", uploads_path, class: "navbar-link" %>
            <%= link_to "Settings", settings_path, class: "navbar-link" %>
            <%= link_to "New Upload", new_upload_path, class: "navbar-link navbar-link-pill" %>

            <%= form_with url: destroy_user_session_path, method: :delete, local: true, html: { class: "navbar-signout-form" } do %>
              <button type="submit" class="navbar-link-button">Sign Out</button>
            <% end %>
          <% else %>
            <%= link_to "Settings", settings_path, class: "navbar-link" %>
            <%= link_to "Sign In", new_user_session_path, class: "navbar-link" %>
            <%= link_to "Register", new_user_registration_path, class: "navbar-link navbar-link-pill" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="flash-wrap">
        <div class="alert alert-success"><%= notice %></div>
      </div>
    <% end %>

    <% if alert %>
      <div class="flash-wrap">
        <div class="alert alert-error"><%= alert %></div>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
