<div class="page-container">
  <div class="hero-card">
    <div class="hero-badge">AI Subscription Audit</div>
    <h1 class="hero-title">Find recurring charges, decide what to cancel, and stop surprise renewals.</h1>
    <p class="hero-subtitle">
      Upload a bank or card statement and turn messy transactions into a clean action plan with
      monthly spend, annualized cost, cancellation candidates, renewal dates, and an exportable audit report.
    </p>

    <div class="button-row">
      <% if user_signed_in? %>
        <%= link_to "Go to Dashboard", uploads_path, class: "btn" %>
        <%= link_to "New Upload", new_upload_path, class: "btn-secondary" %>
        <%= link_to "Try Demo Rows", new_manual_upload_path, class: "btn-secondary" %>
      <% else %>
        <%= link_to "Get Started", new_user_registration_path, class: "btn" %>
        <%= link_to "Sign In", new_user_session_path, class: "btn-secondary" %>
      <% end %>
    </div>
  </div>

  <div class="feature-grid">
    <div class="feature-card">
      <h3>Statement-first audit</h3>
      <p>Analyze CSV, Excel, PDF, or pasted transactions without connecting bank credentials.</p>
    </div>

    <div class="feature-card">
      <h3>Cancellation action plan</h3>
      <p>Mark charges as keep, cancel, watch, ignored, or cancelled and track next follow-up.</p>
    </div>

    <div class="feature-card">
      <h3>Savings report</h3>
      <p>See monthly spend, annualized cost, potential savings, and cancelled savings.</p>
    </div>

    <div class="feature-card">
      <h3>Renewal tracking</h3>
      <p>Export recurring calendar reminders and share a clean audit report.</p>
    </div>
  </div>
</div>
